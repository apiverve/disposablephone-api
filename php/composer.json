            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "disposablephone",
        "disposable phone number api",
        "phone fraud api",
        "burner phone check",
        "temporary phone number detection",
        "phone number spam detection"
    ],
    "homepage": "https://apiverve.com/marketplace/disposablephone?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/disposablephone",
        "source": "https://github.com/apiverve/disposablephone-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
